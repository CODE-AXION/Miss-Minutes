{
  "name": "miss-minutes",
  "version": "1.1.0",
  "description": "Miss Minutes - desktop app for the meeting-notes pipeline",
  "main": "./out/main/index.js",
  "author": "Aadil",
  "homepage": "",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "engine": "node scripts/build-engine.mjs",
    "dist": "npm run engine && npm run build && electron-builder --win",
    "dist:app": "npm run build && electron-builder --win",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@huggingface/transformers": "4.3.1",
    "minisearch": "7.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/righteous": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-store": "12.0.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "lucide-react": "1.56.0",
    "mermaid": "12.2.0",
    "next-themes": "0.4.6",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.3",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "productName": "Miss Minutes",
  "private": true,
  "allowScripts": {
    "electron@44.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
